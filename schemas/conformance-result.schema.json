{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:alt-foundry-kernel:schema:conformance-result:0.4.0",
  "title": "ALT Conformance Result",
  "description": "Portable result for golden transcript replay.",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "checked", "findings"],
  "properties": {
    "ok": { "type": "boolean" },
    "checked": { "type": "integer", "minimum": 0 },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "message"],
        "properties": {
          "path": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    }
  }
}
