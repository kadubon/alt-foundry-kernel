  "$id": "urn:alt:reuse:event:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Artifact",
      "type": "string"
    },
    "attempt": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Attempt",
      "type": "string"
    },
    "context": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Context",
      "type": "string"
    },
    "cost_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Cost Id"
    },
    "cost_stage": {
      "default": "formation",
      "enum": [
        "formation",
        "execution",
        "transfer",
        "validation",
        "refresh",
        "maintenance",
        "repair"
      ],
      "title": "Cost Stage",
      "type": "string"
    },
    "cost_unit": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Cost Unit"
    },
    "dependencies": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Dependencies",
      "type": "array"
    },
    "evaluator": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Evaluator",
      "type": "string"
    },
    "evidence_basis": {
      "enum": [
        "synthetic",
        "source-replay"
      ],
      "title": "Evidence Basis",
      "type": "string"
    },
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Id",
      "type": "string"
    },
    "input_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Digest",
      "type": "string"
    },
    "kind": {
      "enum": [
        "formation",
        "qualify",
        "transfer",
        "request",
        "result",
        "cost",
        "expire",
        "contradict",
        "withdraw",
        "refresh",
        "correct"
      ],
      "title": "Kind",
      "type": "string"
    },
    "offer_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Offer Digest"
    },
    "origin": {
      "additionalProperties": {
        "maxLength": 81,
        "pattern": "^-?(0|[1-9][0-9]*)(/[1-9][0-9]*)?$",
        "type": "string"
      },
      "propertyNames": {
        "enum": [
          "endogenous",
          "external",
          "unresolved"
        ]
      },
      "title": "Origin",
      "type": "object"
    },
    "outcome": {
      "enum": [
        "success",
        "failure",
        "unknown"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "previous": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Previous",
      "type": "string"
    },
    "protocol": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Protocol",
      "type": "string"
    },
    "qualification": {
      "anyOf": [
        {
          "$ref": "#/$defs/Qualification"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "quantity": {
      "maxLength": 81,
      "pattern": "^-?(0|[1-9][0-9]*)(/[1-9][0-9]*)?$",
      "title": "Quantity",
      "type": "string"
    },
    "receiver": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Receiver",
      "type": "string"
    },
    "recorded": {
      "maximum": 1000000,
      "minimum": 0,
      "title": "Recorded",
      "type": "integer"
    },
    "required_cost_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_.:-]+$",
        "type": "string"
      },
      "title": "Required Cost Ids",
      "type": "array"
    },
    "scope": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Scope",
      "type": "string"
    },
    "study": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Study",
      "type": "string"
    },
    "target": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Target"
    },
    "task": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Task",
      "type": "string"
    },
    "time": {
      "maximum": 1000000,
      "minimum": 0,
      "title": "Time",
      "type": "integer"
    },
    "valid_until": {
      "maximum": 1000000,
      "minimum": 0,
      "title": "Valid Until",
      "type": "integer"
    },
    "version": {
      "const": "alt_reuse_event_v1",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "version",
    "id",
    "scope",
    "study",
    "kind",
    "previous",
    "time",
    "recorded",
    "artifact",
    "receiver",
    "context",
    "task",
    "input_digest",
    "protocol",
    "evaluator",
    "offer_digest",
    "attempt",
    "outcome",
    "dependencies",
    "required_cost_ids",
    "cost_id",
    "cost_unit",
    "quantity",
    "valid_until",
    "target",
    "origin",
    "evidence_basis"
  ],
  "title": "Event",
  "type": "object"
}
