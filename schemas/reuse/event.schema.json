        "primitive": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Primitive",
          "type": "string"
        }
      },
      "required": [
        "primitive",
        "arguments"
      ],
