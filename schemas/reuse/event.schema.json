          "maxItems": 24,
          "minItems": 1,
          "title": "Opportunities",
          "type": "array"
        },
        "postconditions": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "type": "string"
          },
          "title": "Postconditions",
          "type": "array"
        },
        "preconditions": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "type": "string"
          },
          "title": "Preconditions",
          "type": "array"
        },
        "protocol": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Protocol",
          "type": "string"
        },
        "quality": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Quality",
          "type": "string"
        },
        "receiver": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Receiver",
          "type": "string"
        },
        "required_cost_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "type": "string"
          },
          "maxItems": 24,
          "minItems": 1,
          "title": "Required Cost Ids",
          "type": "array"
        },
        "restrictions": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "type": "string"
          },
          "title": "Restrictions",
          "type": "array"
        },
        "task_family": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Task Family",
          "type": "string"
        },
        "valid_from": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Valid From",
          "type": "integer"
        },
        "valid_until": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Valid Until",
          "type": "integer"
        },
        "valuation": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Valuation",
          "type": "string"
        },
        "version": {
          "const": "alt_reuse_offer_v1",
          "title": "Version",
          "type": "string"
