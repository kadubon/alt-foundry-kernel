        },
        "inputs": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 24,
          "minItems": 1,
          "title": "Inputs",
          "type": "array"
        },
        "mission": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
