      },
      "required": [
        "version",
        "candidate",
        "receiver",
        "mission",
        "context",
        "task_family",
        "inputs",
        "opportunities",
        "protocol",
        "evaluator",
        "valid_from",
        "valid_until",
        "restrictions",
        "dependencies",
        "preconditions",
        "postconditions",
        "checks",
        "required_cost_ids",
        "comparator",
        "estimand",
        "quality",
        "valuation",
        "evidence_basis"
      ],
