{
  "$defs": {
    "Atom": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "integer",
            "string",
            "reference",
            "parameter"
          ],
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "Atom",
      "type": "object"
    },
    "Candidate": {
      "additionalProperties": false,
      "properties": {
        "artifact_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Artifact Digest",
          "type": "string"
        },
        "dependencies": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "execution_authority": {
          "title": "Execution Authority",
          "type": "null"
        },
        "extractor": {
          "const": "whole-sequence-1",
          "title": "Extractor",
          "type": "string"
        },
        "formation_cost_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Formation Cost Id",
          "type": "string"
        },
        "guards": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "type": "string"
          },
          "title": "Guards",
          "type": "array"
        },
        "implementation_digests": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Implementation Digests",
          "type": "array"
        },
        "qualification": {
          "enum": [
            "candidate",
            "unqualified"
          ],
          "title": "Qualification",
          "type": "string"
        },
        "representation": {
          "items": {
            "$ref": "#/$defs/Step"
          },
          "title": "Representation",
          "type": "array"
        },
        "request_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Digest",
          "type": "string"
        },
        "scope": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Scope",
          "type": "string"
        },
        "settlement": {
          "title": "Settlement",
          "type": "null"
        },
        "source_authentication": {
          "title": "Source Authentication",
          "type": "null"
        },
        "source_cost_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "type": "string"
          },
          "title": "Source Cost Ids",
          "type": "array"
        },
        "source_digests": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Source Digests",
          "type": "array"
        },
        "unresolved": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "type": "string"
          },
          "title": "Unresolved",
          "type": "array"
        },
        "version": {
          "const": "alt_reuse_candidate_v1",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "version",
        "request_digest",
        "extractor",
        "artifact_digest",
        "scope",
        "source_digests",
        "representation",
        "implementation_digests",
        "guards",
        "dependencies",
        "unresolved",
        "formation_cost_id",
        "source_cost_ids",
        "qualification",
        "source_authentication",
        "settlement",
        "execution_authority"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "Formation": {
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Attempt Id",
          "type": "string"
        },
        "cost": {
          "maxLength": 81,
          "pattern": "^-?(0|[1-9][0-9]*)(/[1-9][0-9]*)?$",
          "title": "Cost",
          "type": "string"
        },
        "cost_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Cost Id",
          "type": "string"
        },
        "cost_unit": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Cost Unit",
          "type": "string"
        },
        "cutoff": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Cutoff",
          "type": "integer"
        },
        "expansion_limit": {
          "maximum": 1024,
          "minimum": 1,
          "title": "Expansion Limit",
          "type": "integer"
        },
        "library": {
          "items": {
            "$ref": "#/$defs/Primitive"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Library",
          "type": "array"
        },
        "mode": {
          "enum": [
            "package",
            "sequence"
          ],
          "title": "Mode",
          "type": "string"
        },
        "parameters": {
          "items": {
            "$ref": "#/$defs/Parameter"
          },
          "maxItems": 16,
          "title": "Parameters",
          "type": "array"
        },
        "scope": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Scope",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/Source"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "version": {
          "const": "alt_reuse_formation_v1",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "version",
        "mode",
        "scope",
        "cutoff",
        "sources",
        "library",
        "parameters",
        "attempt_id",
        "cost_id",
        "cost_unit",
        "cost",
        "expansion_limit"
      ],
      "title": "Formation",
      "type": "object"
    },
    "Offer": {
