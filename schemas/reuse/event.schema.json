        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Id",
          "type": "string"
        },
        "offer": {
          "$ref": "#/$defs/Offer"
        },
        "request": {
          "$ref": "#/$defs/Formation"
        }
      },
      "required": [
        "id",
        "request",
        "candidate",
        "offer"
      ],
      "title": "Qualification",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "maxLength": 100000,
          "title": "Content",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "sha256",
        "content"
      ],
      "title": "Source",
      "type": "object"
    },
