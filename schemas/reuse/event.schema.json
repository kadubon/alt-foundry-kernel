      "type": "object"
    },
    "Parameter": {
      "additionalProperties": false,
      "properties": {
        "argument": {
          "maximum": 7,
          "minimum": 0,
          "title": "Argument",
          "type": "integer"
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Name",
          "type": "string"
        },
        "step": {
          "maximum": 7,
          "minimum": 0,
          "title": "Step",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "step",
        "argument"
      ],
      "title": "Parameter",
      "type": "object"
    },
    "Primitive": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Id",
          "type": "string"
        },
        "implementation": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Implementation",
          "type": "string"
