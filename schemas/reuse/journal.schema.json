{
  "$defs": {
    "Source": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "maxLength": 100000,
          "title": "Content",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "sha256",
        "content"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "$id": "urn:alt:reuse:journal:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "events": {
      "items": {
        "$ref": "#/$defs/Source"
      },
      "maxItems": 256,
      "title": "Events",
      "type": "array"
    },
    "scope": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Scope",
      "type": "string"
    },
    "study": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Study",
      "type": "string"
    },
    "version": {
      "const": "alt_reuse_journal_v1",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "version",
    "scope",
    "study",
    "events"
  ],
  "title": "Journal",
  "type": "object"
}
