{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:alt-foundry-kernel:schema:certificate-composition:0.3.0",
  "title": "ALT Certificate Composition",
  "description": "Common-estimand composition and scope-safe negative-certificate propagation contract.",
  "type": "object",
  "additionalProperties": true,
  "required": ["operation", "certificates", "composition", "common_estimand"],
  "properties": {
    "operation": { "type": "string", "enum": ["compose", "negative_propagation"] },
    "certificates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["certificate_id", "estimand_id"],
        "additionalProperties": true,
        "properties": {
          "certificate_id": { "type": "string" },
          "estimand_id": { "type": "string" }
        }
      }
    },
    "composition": {
      "type": "object",
      "required": ["naive"],
      "additionalProperties": true,
      "properties": { "naive": { "type": "boolean" } }
    },
    "common_estimand": { "$ref": "#/$defs/status_object" },
    "negative_scope": { "$ref": "#/$defs/status_object" }
  },
  "$defs": {
    "status_object": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": true,
      "properties": { "status": { "type": "string" } }
    }
  }
}
