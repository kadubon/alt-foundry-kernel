{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:alt-foundry-kernel:schema:cara-claim:0.2.0",
  "title": "ALT CARA Claim",
  "description": "Capability acceleration and target-crossing claim contract.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "claims_target_crossing": { "type": "boolean" },
    "claims_time_to_target_comparison": { "type": "boolean" },
    "asi_target_id": { "type": "string" },
    "capability_basis_id": { "type": "string" },
    "target_validity_certificate": { "$ref": "#/$defs/status_object" },
    "baseline_upper_envelope": { "$ref": "#/$defs/status_object" },
    "target_membership_proof": { "$ref": "#/$defs/status_object" },
    "viability_witness": { "$ref": "#/$defs/status_object" },
    "time_to_target_claim": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "baseline_upper": { "type": "number" },
        "candidate_upper": { "type": "number" }
      }
    }
  },
  "$defs": {
    "status_object": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": true,
      "properties": { "status": { "type": "string" } }
    }
  }
}
