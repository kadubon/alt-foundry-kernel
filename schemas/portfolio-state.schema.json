{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:alt-foundry-kernel:schema:portfolio-state:0.4.0",
  "title": "ALT Portfolio State",
  "description": "Dependency-closed portfolio and capital-accounting state contract.",
  "type": "object",
  "additionalProperties": true,
  "required": ["available_objects", "dependencies", "ledgers"],
  "properties": {
    "available_objects": {
      "type": "array",
      "items": { "type": "string" }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["object_id"],
        "additionalProperties": true,
        "properties": {
          "object_id": { "type": "string" },
          "object_type": { "type": "string" },
          "depends_on": { "type": "string" },
          "available": { "type": "boolean" },
          "included_in_packet": { "type": "boolean" }
        }
      }
    },
    "ledgers": {
      "type": "array",
      "items": { "$ref": "ledger-entry.schema.json" }
    }
  }
}
